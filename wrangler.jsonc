{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goosefarms",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ciftlik-db",
      "database_id": "7ef02290-3883-43aa-a1f6-16d55c8295e3"
    }
  ],
  "observability": { "enabled": true }
}
